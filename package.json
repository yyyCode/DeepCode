{
  "name": "deepcode",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "deepcode": "./bin/deepcode.mjs" },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx scripts/benchmark-context.ts",
    "bench:memory": "tsx scripts/benchmark-memory.ts",
    "bench:prompt": "tsx scripts/benchmark-system-prompt.ts",
    "bench:loop": "tsx scripts/benchmark-agent-loop.ts",
    "lint": "node scripts/check-boundaries.mjs && node scripts/check-workflow-hardening.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
