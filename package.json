{
  "name": "deepcode",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "deepcode": "./packages/cli/bin/deepcode.mjs" },
  "scripts": {
    "dev": "tsx packages/cli/src/main.ts",
    "companion": "pnpm --filter @deepcode/companion dev",
    "companion:cloud": "pnpm --filter @deepcode/companion start:cloud",
    "typecheck": "tsc --noEmit && tsc -p packages/companion/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "node scripts/check-boundaries.mjs && node scripts/check-workflow-hardening.mjs"
  },
  "devDependencies": {
    "@deepcode/builtins": "workspace:*",
    "@deepcode/companion": "workspace:*",
    "@deepcode/cli": "workspace:*",
    "@deepcode/contract": "workspace:*",
    "@deepcode/core": "workspace:*",
    "@deepcode/mcp": "workspace:*",
    "@deepcode/providers": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
