{
  "description": "把 .deepcode/hookify.*.local.md 里的规则编译成 PreToolUse 判定",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
