# 复制成 .env 再填。compose 会自动读这个文件。
# 管理员：服务启动时按这个邮箱查找，没有就创建；已有账号会被提升为 admin。
# 账号已存在时不会改密码 —— 改密码请重新创建账号或直接操作数据库。
DEEPCODE_ADMIN_EMAIL=admin@example.com
DEEPCODE_ADMIN_PASSWORD=change-me-please

# 对外访问地址。放在反向代理后面时填 https://你的域名，
# 同时把 COOKIE_SECURE 打开，否则登录 cookie 会随明文 HTTP 发出去。
# DEEPCODE_PUBLIC_ORIGIN=https://chat.example.com
DEEPCODE_COOKIE_SECURE=0

# 模型配置。也可以用 openai 兼容端点（provider=openai + baseUrl）。
DEEPCODE_API_KEY=
DEEPCODE_PROVIDER=anthropic
DEEPCODE_MODEL=claude-sonnet-5-5
# DEEPCODE_BASE_URL=

# 语音输入（云端）：OpenAI 兼容的 /audio/transcriptions。不填 key 就不启用。
# 这个 key 与上面的聊天模型分开 —— 文本端点不一定有语音识别。
DEEPCODE_ASR_API_KEY=
# DEEPCODE_ASR_BASE_URL=https://api.openai.com/v1
# DEEPCODE_ASR_MODEL=whisper-1
# DEEPCODE_ASR_LANGUAGE=zh

# 语音输入（本地）：先跑 pnpm --filter @deepcode/companion asr:model 下载模型。
# 模型默认放在 ~/.deepcode/models/asr/sensevoice-small-int8。
# Docker 里需要把模型目录挂进容器，再把 MODEL_DIR 指向容器内路径。
# DEEPCODE_ASR_PROVIDER=local
# DEEPCODE_ASR_MODEL_DIR=
# DEEPCODE_ASR_NUM_THREADS=2

# 语音输入（讯飞极速录音转写）：APIKey 复用上面的 DEEPCODE_ASR_API_KEY。
# 短音频约 20 秒起；前端会自动转成 16 kHz 单声道 WAV。
# DEEPCODE_ASR_PROVIDER=iflytek
# DEEPCODE_ASR_APP_ID=
# DEEPCODE_ASR_API_SECRET=
# DEEPCODE_ASR_LANGUAGE=zh_cn

# 宿主机映射端口
COMPANION_PORT=3001
